      "link": null,
      "locked": false,
      "text": "class Product:\n    count = 0\n    def __init__(self,name , price):\n        self.name = name\n        self.price = price\n        count += 1 -> Here I cannot increase the value of count in that way\nbecause it is a constructor that is instance and count is the memeber of procudct\nthat's why I have to write here   ClassNmae.attribute",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Product:\n    count = 0\n    def __init__(self,name , price):\n        self.name = name\n        self.price = price\n        count += 1 -> Here I cannot increase the value of count in that way\nbecause it is a constructor that is instance and count is the memeber of procudct\nthat's why I have to write here   ClassNmae.attribute",
      "autoResize": true,
      "lineHeight": 1.25
